# ==============================================================================
# CONFIGURAÇÃO DO SERVIDOR — ECOSAFETY & ECOCLINIC (PRESENÇA + TRIAGEM)
# ==============================================================================

# Porta do servidor HTTP unificado
PORT=3000

# Ambiente: development ou production
NODE_ENV=development

# Chave secreta para tokens JWT da equipe clínica (altere em produção)
JWT_SECRET=ecoclinic-jwt-super-secret-key-2026

# ------------------------------------------------------------------------------
# BANCO DE DADOS (UNIFICADO)
# ------------------------------------------------------------------------------
# Se omitido ou em branco, o servidor usa automaticamente o SQLite local
# em "data/triagem.db" com todas as tabelas de Presença e Triagem integradas.
#
# Para conectar ao PostgreSQL ou Supabase (após rodar o arquivo supabase.sql):
# DATABASE_URL=postgresql://postgres:[SUA-SENHA]@[HOST-DO-PROJETO]:5432/postgres
