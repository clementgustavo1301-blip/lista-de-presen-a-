{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api?__pathname=/api/$1"
    },
    {
      "source": "/presenca",
      "destination": "/presenca/index.html"
    },
    {
      "source": "/triagem",
      "destination": "/triagem/index.html"
    },
    {
      "source": "/favicon.ico",
      "destination": "/favicon.svg"
    }
  ]
}
