{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/presenca/?",
      "dest": "/public/presenca/index.html"
    },
    {
      "src": "/presenca/(.*)",
      "dest": "/public/presenca/$1"
    },
    {
      "src": "/triagem/?",
      "dest": "/public/triagem/index.html"
    },
    {
      "src": "/triagem/(.*)",
      "dest": "/public/triagem/$1"
    },
    {
      "src": "/favicon.ico",
      "dest": "/public/favicon.svg"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ]
}
